[Unit]
Description=Smart Zain Telegram application
Wants=network-online.target smart-zain-engine.service smart-zain-files.service
After=network-online.target smart-zain-engine.service smart-zain-files.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=smart-zain
Group=smart-zain
WorkingDirectory=/srv/smart-zain
EnvironmentFile=/etc/smart-zain/services.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/smart-zain/.venv/bin/python -B -m services telegram --root /srv/smart-zain
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillMode=control-group
OOMPolicy=kill
CPUAccounting=yes
MemoryAccounting=yes
IOAccounting=yes
CPUWeight=200
IOWeight=200
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=smart-zain-telegram

[Install]
WantedBy=multi-user.target
