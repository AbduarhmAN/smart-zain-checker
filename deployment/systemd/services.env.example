# Copy to /etc/smart-zain/services.env owned by root:smart-zain, mode 0640.
# Generate a unique secret; never use this example text as the deployed token.
ZAIN_IPC_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
ZAIN_ENGINE_PORT=18701
ZAIN_FILES_PORT=18702
ZAIN_BROWSER_PORT=18703
ZAIN_TELEGRAM_PORT=18704
ZAIN_PROJECT_ROOT=/srv/smart-zain
ZAIN_BROWSER_HEADLESS=1
# Bounded admission, not a measured capacity guarantee. Tune from a staged load test.
ZAIN_BROWSER_CONCURRENCY=4
ZAIN_BROWSER_TASK_LIMIT=16
ZAIN_BROWSER_ROUTE_LIMIT=4
